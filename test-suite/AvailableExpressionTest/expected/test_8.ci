// Bloc 0
t0 = a + b
// Avail_IN  : []
// Avail_OUT : [a+b]

// Bloc 1
t1 = c * d
// Avail_IN  : [a+b]
// Avail_OUT : [a+b, c*d]

// Bloc 2
if t0 goto L1
// Avail_IN  : [a+b, c*d]
// Avail_OUT : [a+b, c*d]

// Bloc 3
a = t1
// Avail_IN  : [a+b, c*d]
// Avail_OUT : [c*d]

// Bloc 4
t2 = a + b
// Avail_IN  : [c*d]
// Avail_OUT : [a+b, c*d]

// Bloc 5
t3 = t1
// Avail_IN  : [a+b, c*d]
// Avail_OUT : [a+b, c*d]

